{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "montessori-admissions",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "vars": {
    "ADMISSIONS_API_URL": "https://montessori-lms-api-625997821641.northamerica-south1.run.app",
    "ENROLLMENT_API_URL": "https://montessori-enrollment-api-625997821641.northamerica-south1.run.app",
    "ENROLLMENT_API_MODE": "clean",
    "ADMISSIONS_DEMO_MODE": "false",
    "NEXT_PUBLIC_ADMISSIONS_DEMO_MODE": "false"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
